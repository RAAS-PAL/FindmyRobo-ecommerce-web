# Copy to .env.local for development, and set the same names in the Vercel
# project settings for production. Never commit real values.

# ---------------------------------------------------------------- Supabase
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses row-level security — never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ------------------------------------------------------------ Admin access
# Legacy password gate + the secret used to sign the admin session cookie.
ADMIN_PASSWORD=choose-a-strong-password
AUTH_SECRET=generate-with-openssl-rand-base64-32

# --------------------------------------------------- Omise / Opn Payments
# Dashboard -> Keys. Test keys (pkey_test_/skey_test_) work before the
# merchant account is fully approved; swap to live keys only at launch.
#
# Public key reaches the browser by design: Omise.js uses it to tokenize the
# card so raw card data never touches our server (keeps us at PCI SAQ-A).
NEXT_PUBLIC_OMISE_PUBLIC_KEY=pkey_test_xxx
# Server-only. Charges money — never expose to the browser.
OMISE_SECRET_KEY=skey_test_xxx
#
# Until both Omise keys are set the storefront still works: checkout creates a
# real order and shows the "our team will contact you" confirmation instead of
# collecting payment. Setting them switches payment on with no code change.
#
# Webhook to register in the Omise dashboard (Settings -> Webhooks):
#   https://your-domain.com/api/webhooks/omise

# ---------------------------------------------------------------- Site URL
# Public origin used to build payment return URLs (3-D Secure, PromptPay).
# Set this in production so Omise redirects to the real domain rather than an
# internal Vercel preview host. Falls back to the request origin when unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
