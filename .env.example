# Copy to .env.local for development, and set the same names in the Vercel
# project settings for production. Never commit real values.

# ---------------------------------------------------------------- Supabase
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses row-level security — never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ------------------------------------------------------------ Admin access
# Nothing to set. Admin access is role-based via Supabase: sign in normally,
# then set your profile row to role='admin' (see supabase/schema.sql step 4).
# The old ADMIN_PASSWORD / AUTH_SECRET password gate is gone — do not
# reintroduce them, lib/adminAuth.ts no longer reads either one.

# ------------------------------------------------------- Resend (app email)
# Sends the order confirmation and the sales-team alert. This is SEPARATE from
# the Supabase auth emails (signup/password reset), which reach Resend over
# SMTP configured in the Supabase dashboard — same account, same verified
# domain, different door.
#
# Dashboard -> API Keys. Server-only: this key can send mail as your domain,
# so it must never carry a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=re_xxx
#
# Until this is set the storefront still works: orders are created normally and
# the emails are skipped with a warning in the logs.
#
# Optional. Where new-order alerts go; defaults to siteConfig.salesContact.email.
# Comma-separate for several people — no deploy needed to change who is alerted.
# Use at least one shared/monitored inbox: if alerts land only with one person
# and they are on leave, orders are missed.
# SALES_ALERT_EMAIL=sales@raaspal.com, chris@raaspal.com, ops@raaspal.com
#
# Optional. Must be a domain verified in Resend.
# EMAIL_FROM=FindMyRobo <noreply@send.findmyrobo.com>

# --------------------------------------------- Cloudflare Turnstile (CAPTCHA)
# Bot protection on signup, which guards the Resend quota above. Two halves:
#   - the SITE key below (public, reaches the browser by design)
#   - the SECRET key, pasted into the Supabase dashboard under
#     Authentication -> Attack Protection -> Enable Captcha protection
# Supabase verifies the token server-side; the widget alone stops nothing.
#
# Leave unset and signup works exactly as before, with no widget shown.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# --------------------------------------------------- Omise / Opn Payments
# Dashboard -> Keys. Test keys (pkey_test_/skey_test_) work before the
# merchant account is fully approved; swap to live keys only at launch.
#
# Public key reaches the browser by design: Omise.js uses it to tokenize the
# card so raw card data never touches our server (keeps us at PCI SAQ-A).
NEXT_PUBLIC_OMISE_PUBLIC_KEY=pkey_test_xxx
# Server-only. Charges money — never expose to the browser.
OMISE_SECRET_KEY=skey_test_xxx
#
# Until both Omise keys are set the storefront still works: checkout creates a
# real order and shows the "our team will contact you" confirmation instead of
# collecting payment. Setting them switches payment on with no code change.
#
# Webhook to register in the Omise dashboard (Settings -> Webhooks):
#   https://your-domain.com/api/webhooks/omise

# ----------------------------------------------- Sokochan (3PL fulfilment)
# Warehouse/OMS that picks, packs, and ships orders. Docs:
# https://oms.sokochan.com/docs/1.0 — credentials are issued by Sokochan.
# Auth is HTTP Basic: base64(account_login + ":" + api_key). Both server-only.
#
# Until both are set, the admin "Send to warehouse" button shows a
# "not connected" state and nothing is ever sent to Sokochan.
SOKOCHAN_LOGIN=your-account-login
SOKOCHAN_API_KEY=your-api-key
# Optional — override the API base (e.g. a sandbox host). Defaults to production.
# SOKOCHAN_API_BASE=https://oms.sokochan.com/api/1.0
#
# Optional shared secret guarding the shipping webhook. When set, register the
# webhook in Sokochan as: https://your-domain.com/api/webhooks/sokochan?token=THIS
SOKOCHAN_WEBHOOK_SECRET=generate-a-random-token

# ---------------------------------------------------------------- Site URL
# Public origin used to build payment return URLs (3-D Secure, PromptPay).
# Set this in production so Omise redirects to the real domain rather than an
# internal Vercel preview host. Falls back to the request origin when unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
