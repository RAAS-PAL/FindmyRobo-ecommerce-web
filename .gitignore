# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Payload: uploads from offline tests (PAYLOAD_MEDIA_STORAGE=local)
/.payload-media

# internal planning docs stay on your machine — the PRD once held live
# credentials, and GitHub is no place for either
/docs/PRD-*.xlsx

# Office lock files (~$name.xlsx), created while a document is open
~$*
